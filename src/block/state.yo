// markdown_yo — Block parser state
//
// Tracks line positions, indentation, and nesting for block-level parsing.
// Line markers are precomputed once for O(1) line access.
pragma(Pragma.AllowUnsafe);
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ memchr } :: import("std/libc/string");
{ Options, ParentType, Reference, Env } :: import("../types.yo");
{ HtmlRenderer } :: import("../renderer.yo");
{ InlineState } :: import("../inline/state.yo");
{ is_space } :: import("../common/utils.yo");

BlockState :: struct(
  // normalized source bytes (owns the buffer src_ptr points into)
  src : ArrayList(u8),
  // raw pointer for fast byte access
  src_ptr : *u8,
  // total byte length
  src_len : i32,
  // Line markers (precomputed) — ArrayLists own the memory
  // byte position of line start
  b_marks : ArrayList(i32),
  // byte position of line end (before newline)
  e_marks : ArrayList(i32),
  // first non-space offset from b_marks
  t_shift : ArrayList(i32),
  // indentation (spaces, tabs expanded to 4)
  s_count : ArrayList(i32),
  // blockquote compensation
  bs_count : ArrayList(i32),
  // Cached raw pointers for unchecked O(1) access (set after line scan)
  _bm : *i32,
  _em : *i32,
  _ts : *i32,
  _sc : *i32,
  _bs : *i32,
  // Per-line flags (precomputed during line scan)
  // 1 if line contains '|', else 0
  _pipe_flags : ArrayList(u8),
  // cached pointer into _pipe_flags
  _pf : *u8,
  // current line being parsed
  line : i32,
  // total number of lines
  line_max : i32,
  // current block indent level
  blk_indent : i32,
  // tight list mode (suppress <p>)
  tight : bool,
  // definition list indent
  dd_indent : i32,
  // current list indent
  list_indent : i32,
  parent_type : ParentType,
  // nesting level
  level : i32,
  // link references
  env : Env,
  // for direct SAX-style calls
  renderer : *HtmlRenderer,
  options : *Options,
  // Reusable inline state — avoids repeated ArrayList allocation/deallocation
  _inline_state : InlineState,
  // Reusable scratch buffer for multi-line string building (paragraph, lheading, etc.)
  _line_buf : ArrayList(u8),
  // Reusable blockquote save buffers — shared across recursive block_tokenize calls
  _bq_save_bm : ArrayList(i32),
  _bq_save_ts : ArrayList(i32),
  _bq_save_sc : ArrayList(i32),
  _bq_save_bs : ArrayList(i32)
);

// Normalize source: replace \r\n → \n, lone \r → \n, \0 → U+FFFD (rare path)
_normalize_source :: (fn(src_p : *u8, len : i32) -> ArrayList(u8))({
  (out : ArrayList(u8)) = ArrayList(u8).with_capacity(usize(len));
  (i : i32) = i32(0);
  (run_start : i32) = i32(0);

  while(i < len, {
    (b : u8) = (src_p.add(usize(i))).*;
    cond(
      (b == u8(0x0D)) => {
        if(i > run_start, {
          out.extend_from_ptr(src_p.add(usize(run_start)), usize(i - run_start));
        });
        _ := out.push(u8(0x0A));
        if(((i + i32(1)) < len) && ((src_p.add(usize(i + i32(1)))).* == u8(0x0A)), {
          i = (i + i32(2));
        }, {
          i = (i + i32(1));
        });
        run_start = i;
      },
      (b == u8(0x00)) => {
        if(i > run_start, {
          out.extend_from_ptr(src_p.add(usize(run_start)), usize(i - run_start));
        });
        _ := out.push(u8(0xEF));
        _ := out.push(u8(0xBF));
        _ := out.push(u8(0xBD));
        i = (i + i32(1));
        run_start = i;
      },
      true => {
        i = (i + i32(1));
      }
    );
  });
  if(len > run_start, {
    out.extend_from_ptr(src_p.add(usize(run_start)), usize(len - run_start));
  });
  out
});

// Build BlockState from already-normalized source (rare path — only when \r or \0 found)
_build_block_state_from_normalized :: (fn(src : &ArrayList(u8), env : &Env, renderer : *HtmlRenderer, options : *Options) -> BlockState)({
  (len : i32) = i32(src.len());
  (est_lines : usize) = ((usize(len) / usize(40)) + usize(16));
  (b_marks : ArrayList(i32)) = ArrayList(i32).with_capacity(est_lines);
  (e_marks : ArrayList(i32)) = ArrayList(i32).with_capacity(est_lines);
  (t_shift : ArrayList(i32)) = ArrayList(i32).with_capacity(est_lines);
  (s_count : ArrayList(i32)) = ArrayList(i32).with_capacity(est_lines);
  (bs_count : ArrayList(i32)) = ArrayList(i32).with_capacity(est_lines);
  (pipe_flags : ArrayList(u8)) = ArrayList(u8).with_capacity(est_lines);

  (src_p : *u8) = match(
    src.ptr(),
    .Some(p) => p,
    .None => (*u8)("")
  );

  (pos : i32) = i32(0);
  (indent : i32) = i32(0);
  (offset : i32) = i32(0);
  (line_start : i32) = i32(0);
  (indent_found : bool) = false;
  (line_has_pipe : bool) = false;

  while(pos < len, {
    (ch : u8) = (src_p.add(usize(pos))).*;

    // Match markdown-it: push line entry on newline OR at end of input
    (is_line_end : bool) = ((ch == u8(0x0A)) || (pos == (len - i32(1))));
    if(is_line_end, {
      // When last char is not newline, include it in the line by advancing pos
      if(ch != u8(0x0A), {
        pos = (pos + i32(1));
        if(!indent_found, {
          cond(
            (ch == u8(0x20)) => {
              indent = (indent + i32(1));
              offset = (offset + i32(1));
            },
            (ch == u8(0x09)) => {
              indent = (indent + (i32(4) - (indent % i32(4))));
              offset = (offset + i32(1));
            },
            true => {
              indent_found = true;
            }
          );
        });
        if(ch == u8(0x7C), {
          line_has_pipe = true;
        });
      });

      _ := b_marks.push(line_start);
      _ := e_marks.push(pos);
      if(!indent_found, {
        _ := t_shift.push(pos - line_start);
        _ := s_count.push(i32(0));
      }, {
        _ := t_shift.push(offset);
        _ := s_count.push(indent);
      });
      _ := bs_count.push(i32(0));
      _ := pipe_flags.push(cond(line_has_pipe => u8(1), true => u8(0)));
      line_start = (pos + i32(1));
      indent = i32(0);
      offset = i32(0);
      indent_found = false;
      line_has_pipe = false;
      pos = (pos + i32(1));
    }, {
      if(!indent_found, {
        cond(
          (ch == u8(0x20)) => {
            indent = (indent + i32(1));
            offset = (offset + i32(1));
          },
          (ch == u8(0x09)) => {
            indent = (indent + (i32(4) - (indent % i32(4))));
            offset = (offset + i32(1));
          },
          true => {
            indent_found = true;
          }
        );
      });
      if(ch == u8(0x7C), {
        line_has_pipe = true;
      });
      pos = (pos + i32(1));
    });
  });

  _ := b_marks.push(line_start);
  _ := e_marks.push(len);
  if(!indent_found, {
    _ := t_shift.push(len - line_start);
    _ := s_count.push(i32(0));
  }, {
    _ := t_shift.push(offset);
    _ := s_count.push(indent);
  });
  _ := bs_count.push(i32(0));
  _ := pipe_flags.push(cond(line_has_pipe => u8(1), true => u8(0)));

  (line_count : i32) = (i32(b_marks.len()) - i32(1));

  BlockState(
    src : src,
    src_ptr : src_p,
    src_len : len,
    b_marks : b_marks,
    e_marks : e_marks,
    t_shift : t_shift,
    s_count : s_count,
    bs_count : bs_count,
    _bm : b_marks.ptr().unwrap(),
    _em : e_marks.ptr().unwrap(),
    _ts : t_shift.ptr().unwrap(),
    _sc : s_count.ptr().unwrap(),
    _bs : bs_count.ptr().unwrap(),
    _pipe_flags : pipe_flags,
    _pf : pipe_flags.ptr().unwrap(),
    line : i32(0),
    line_max : line_count,
    blk_indent : i32(0),
    tight : false,
    dd_indent : (i32(0) - i32(1)),
    list_indent : (i32(0) - i32(1)),
    parent_type : .Root,
    level : i32(0),
    env : env,
    renderer : renderer,
    options : options,
    _inline_state : InlineState.reusable(env, renderer, options),
    _line_buf : ArrayList(u8).new(),
    _bq_save_bm : ArrayList(i32).new(),
    _bq_save_ts : ArrayList(i32).new(),
    _bq_save_sc : ArrayList(i32).new(),
    _bq_save_bs : ArrayList(i32).new()
  )
});

impl(
  BlockState,
  // Create a new BlockState with integrated normalization and line marker precomputation.
  // Merges normalize + line scan into a single pass over the source.
  new : (fn(src : &ArrayList(u8), env : &Env, renderer : *HtmlRenderer, options : *Options) -> Self)({
    (len : i32) = i32(src.len());

    // Estimate line count for pre-allocation (avg ~40 bytes/line)
    (est_lines : usize) = ((usize(len) / usize(40)) + usize(16));
    (b_marks : ArrayList(i32)) = ArrayList(i32).with_capacity(est_lines);
    (e_marks : ArrayList(i32)) = ArrayList(i32).with_capacity(est_lines);
    (t_shift : ArrayList(i32)) = ArrayList(i32).with_capacity(est_lines);
    (s_count : ArrayList(i32)) = ArrayList(i32).with_capacity(est_lines);
    (bs_count : ArrayList(i32)) = ArrayList(i32).with_capacity(est_lines);
    (pipe_flags : ArrayList(u8)) = ArrayList(u8).with_capacity(est_lines);

    (src_p : *u8) = match(
      src.ptr(),
      .Some(p) => p,
      .None => (*u8)("")
    );

    // Fast check: does input need normalization? (\r or \0 present)
    // Use memchr for SIMD-accelerated scan of entire input
    (needs_normalize : bool) = false;
    match(
      unsafe(memchr((*void)(src_p), int(0x0D), usize(len))),
      .Some(_) => {
        needs_normalize = true;
      },
      .None => ()
    );
    if(!needs_normalize, {
      match(
        unsafe(memchr((*void)(src_p), int(0x00), usize(len))),
        .Some(_) => {
          needs_normalize = true;
        },
        .None => ()
      );
    });
    if(needs_normalize, {
      (norm_src : ArrayList(u8)) = _normalize_source(src_p, len);
      return(_build_block_state_from_normalized(norm_src, env, renderer, options));
    });

    // Line scanning: precompute line markers
    (pos : i32) = i32(0);
    (indent : i32) = i32(0);
    (offset : i32) = i32(0);
    (line_start : i32) = i32(0);
    (indent_found : bool) = false;
    (line_has_pipe : bool) = false;

    while(pos < len, {
      (ch : u8) = (src_p.add(usize(pos))).*;

      // Match markdown-it: push line entry on newline OR at end of input
      if((ch == u8(0x0A)) || (pos == (len - i32(1))), {
        // When last char is not newline, include it in the line by advancing pos
        if(ch != u8(0x0A), {
          pos = (pos + i32(1));
          // Also handle indent for the last char if not yet found
          if(!indent_found, {
            cond(
              (ch == u8(0x20)) => {
                indent = (indent + i32(1));
                offset = (offset + i32(1));
              },
              (ch == u8(0x09)) => {
                indent = (indent + (i32(4) - (indent % i32(4))));
                offset = (offset + i32(1));
              },
              true => {
                indent_found = true;
              }
            );
          });
          if(ch == u8(0x7C), {
            line_has_pipe = true;
          });
        });

        _ := b_marks.push(line_start);
        _ := e_marks.push(pos);
        if(!indent_found, {
          _ := t_shift.push(pos - line_start);
          _ := s_count.push(i32(0));
        }, {
          _ := t_shift.push(offset);
          _ := s_count.push(indent);
        });
        _ := bs_count.push(i32(0));
        _ := pipe_flags.push(cond(line_has_pipe => u8(1), true => u8(0)));

        line_start = (pos + i32(1));
        indent = i32(0);
        offset = i32(0);
        indent_found = false;
        line_has_pipe = false;
      }, {
        if(!indent_found, {
          cond(
            (ch == u8(0x20)) => {
              indent = (indent + i32(1));
              offset = (offset + i32(1));
            },
            (ch == u8(0x09)) => {
              indent = (indent + (i32(4) - (indent % i32(4))));
              offset = (offset + i32(1));
            },
            true => {
              indent_found = true;
            }
          );
        });
        if(ch == u8(0x7C), {
          line_has_pipe = true;
        });
      });
      pos = (pos + i32(1));
    });

    // Handle last line
    _ := b_marks.push(line_start);
    _ := e_marks.push(len);
    if(!indent_found, {
      _ := t_shift.push(len - line_start);
      _ := s_count.push(i32(0));
    }, {
      _ := t_shift.push(offset);
      _ := s_count.push(indent);
    });
    _ := bs_count.push(i32(0));
    _ := pipe_flags.push(cond(line_has_pipe => u8(1), true => u8(0)));

    (line_count : i32) = (i32(b_marks.len()) - i32(1));

    Self(
      src : src,
      src_ptr : src_p,
      src_len : len,
      b_marks : b_marks,
      e_marks : e_marks,
      t_shift : t_shift,
      s_count : s_count,
      bs_count : bs_count,
      _bm : b_marks.ptr().unwrap(),
      _em : e_marks.ptr().unwrap(),
      _ts : t_shift.ptr().unwrap(),
      _sc : s_count.ptr().unwrap(),
      _bs : bs_count.ptr().unwrap(),
      _pipe_flags : pipe_flags,
      _pf : pipe_flags.ptr().unwrap(),
      line : i32(0),
      line_max : line_count,
      blk_indent : i32(0),
      tight : false,
      dd_indent : (i32(0) - i32(1)),
      list_indent : (i32(0) - i32(1)),
      parent_type : .Root,
      level : i32(0),
      env : env,
      renderer : renderer,
      options : options,
      _inline_state : InlineState.reusable(env, renderer, options),
      _line_buf : ArrayList(u8).new(),
      _bq_save_bm : ArrayList(i32).new(),
      _bq_save_ts : ArrayList(i32).new(),
      _bq_save_sc : ArrayList(i32).new(),
      _bq_save_bs : ArrayList(i32).new()
    )
  }),
  // Unchecked line marker accessors — raw pointer offset, no bounds/NULL check
  bm : (fn(self : *Self, line : i32) -> i32)((self.*._bm.add(usize(line))).*),
  em : (fn(self : *Self, line : i32) -> i32)((self.*._em.add(usize(line))).*),
  ts : (fn(self : *Self, line : i32) -> i32)((self.*._ts.add(usize(line))).*),
  sc : (fn(self : *Self, line : i32) -> i32)((self.*._sc.add(usize(line))).*),
  bs : (fn(self : *Self, line : i32) -> i32)((self.*._bs.add(usize(line))).*),
  has_pipe : (fn(self : *Self, line : i32) -> bool)((self.*._pf.add(usize(line))).* != u8(0)),
  set_bm : (fn(self : *Self, line : i32, val : i32) -> unit)({
    (self.*._bm.add(usize(line))).* = val;
  }),
  set_em : (fn(self : *Self, line : i32, val : i32) -> unit)({
    (self.*._em.add(usize(line))).* = val;
  }),
  set_ts : (fn(self : *Self, line : i32, val : i32) -> unit)({
    (self.*._ts.add(usize(line))).* = val;
  }),
  set_sc : (fn(self : *Self, line : i32, val : i32) -> unit)({
    (self.*._sc.add(usize(line))).* = val;
  }),
  set_bs : (fn(self : *Self, line : i32, val : i32) -> unit)({
    (self.*._bs.add(usize(line))).* = val;
  }),
  // Check if a line is empty (only whitespace)
  is_empty : (fn(self : *Self, line : i32) -> bool)({
    (bm_v : i32) = self.bm(line);
    (ts_v : i32) = self.ts(line);
    (bm_v + ts_v) >= self.em(line)
  }),
  // Skip whitespace from position `from` on line `line`, return new position
  skip_spaces : (fn(self : *Self, pos : i32) -> i32)({
    (p : i32) = pos;
    while(p < self.*.src_len, {
      (ch : u8) = (self.*.src_ptr.add(usize(p))).*;
      if(!is_space(i32(ch)), {
        return(p);
      });
      p = (p + i32(1));
    });
    p
  }),
  // Skip spaces backwards from `pos` to `min`
  skip_spaces_back : (fn(self : *Self, pos : i32, min : i32) -> i32)({
    (p : i32) = (pos - i32(1));
    while(p >= min, {
      (ch : u8) = (self.*.src_ptr.add(usize(p))).*;
      if(!is_space(i32(ch)), {
        return(p + i32(1));
      });
      p = (p - i32(1));
    });
    min
  }),
  // Skip char `code` starting at `pos`
  skip_chars : (fn(self : *Self, pos : i32, code : u8) -> i32)({
    (p : i32) = pos;
    while(p < self.*.src_len, {
      if((self.*.src_ptr.add(usize(p))).* != code, {
        return(p);
      });
      p = (p + i32(1));
    });
    p
  }),
  // Skip char backwards
  skip_chars_back : (fn(self : *Self, pos : i32, code : u8, min : i32) -> i32)({
    (p : i32) = (pos - i32(1));
    while(p >= min, {
      if((self.*.src_ptr.add(usize(p))).* != code, {
        return(p + i32(1));
      });
      p = (p - i32(1));
    });
    min
  }),
  // Get byte at position
  char_at : (fn(self : *Self, pos : i32) -> i32)(
    cond(
      ((pos < i32(0)) || (pos >= self.*.src_len)) => (i32(0) - i32(1)),
      true => i32((self.*.src_ptr.add(usize(pos))).*)
    )
  )
);

export(BlockState);
