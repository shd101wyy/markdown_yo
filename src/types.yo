// markdown_yo — Core types and options
//
// Enums and structs used throughout the parser, renderer, and CLI.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");

// ---------------------------------------------------------------------------
// Options
// ---------------------------------------------------------------------------
Options :: struct(
  // Allow raw HTML tags in markdown source
  html : bool,
  // Self-close tags as <br /> vs <br>
  xhtml_out : bool,
  // Convert \n to <br> in paragraphs
  breaks : bool,
  // CSS class prefix for fenced code blocks
  lang_prefix : String,
  // Auto-detect URLs as links
  linkify : bool,
  // Enable typographic replacements & smart quotes
  typographer : bool,
  // GFM tables
  enable_table : bool,
  // GFM strikethrough
  enable_strikethrough : bool,
  // Subscript with ~text~
  enable_subscript : bool,
  // Superscript with ^text^
  enable_superscript : bool,
  // Highlight with ==text==
  enable_mark : bool,
  // Math with $...$ and $$...$$
  enable_math : bool,
  // Emoji shortcodes :smile: → 😄
  enable_emoji : bool,
  // Wiki-style links [[page]] or [[page|text]]
  enable_wikilink : bool,
  // CriticMarkup {++add++} {--del--} {~~old~>new~~} {==mark==} {>>comment<<}
  enable_critic : bool,
  // Abbreviations *[abbr]: expansion
  enable_abbr : bool,
  // Definition lists (term + :   definition)
  enable_deflist : bool,
  // Admonition blocks !!! type / ??? type / ???+ type
  enable_admonition : bool,
  // GitHub/Obsidian callouts > [!type] title
  enable_callout : bool,
  // Footnotes [^id] and [^id]: content
  enable_footnote : bool,
  // Emit data-source-line attributes on block elements
  enable_source_map : bool,
  max_nesting : i32 // Max nesting depth
);

// An abbreviation entry: byte ranges into the source for pattern and title
AbbrEntry :: struct(
  pattern_start : i32,
  pattern_end : i32,
  title_start : i32,
  title_end : i32,
  pattern_len : i32
);
derive(AbbrEntry, Copy, Clone);

default_options :: (fn() -> Options)(
  Options(
    html : false,
    xhtml_out : false,
    breaks : false,
    lang_prefix : `language-`,
    linkify : false,
    typographer : false,
    enable_table : true,
    enable_strikethrough : true,
    enable_subscript : false,
    enable_superscript : false,
    enable_mark : false,
    enable_math : false,
    enable_emoji : false,
    enable_wikilink : false,
    enable_critic : false,
    enable_abbr : false,
    enable_deflist : false,
    enable_admonition : false,
    enable_callout : false,
    enable_footnote : false,
    enable_source_map : false,
    max_nesting : i32(100)
  )
);

commonmark_options :: (fn() -> Options)(
  Options(
    html : true,
    xhtml_out : true,
    breaks : false,
    lang_prefix : `language-`,
    linkify : false,
    typographer : false,
    enable_table : false,
    enable_strikethrough : false,
    enable_subscript : false,
    enable_superscript : false,
    enable_mark : false,
    enable_math : false,
    enable_emoji : false,
    enable_wikilink : false,
    enable_critic : false,
    enable_abbr : false,
    enable_deflist : false,
    enable_admonition : false,
    enable_callout : false,
    enable_footnote : false,
    enable_source_map : false,
    max_nesting : i32(20)
  )
);

// ---------------------------------------------------------------------------
// Block-level enums
// ---------------------------------------------------------------------------
ParentType :: enum(
  Root,
  Blockquote,
  List,
  DefList,
  Admonition,
  Paragraph
);
derive(ParentType, Copy, Clone);

TableAlign :: enum(
  None,
  Left,
  Center,
  Right
);
derive(TableAlign, Copy, Clone);

// ---------------------------------------------------------------------------
// Footnote definition — stores label and content for end-of-document rendering
// ---------------------------------------------------------------------------
FootnoteDef :: struct(
  // byte offset of label start in source
  label_start : i32,
  // byte offset of label end in source
  label_end : i32,
  // byte offset of content start on first line
  content_start : i32,
  // first content line (after adjusting for [^label]:)
  line_start : i32,
  // line after last content line
  line_end : i32,
  // Adjusted first-line state for re-parsing
  // adjusted bMarks for first line
  adj_bmark : i32,
  // adjusted tShift for first line
  adj_tshift : i32,
  adj_scount : i32 // adjusted sCount for first line
);
derive(FootnoteDef, Copy, Clone);

// ---------------------------------------------------------------------------
// Inline token types
// ---------------------------------------------------------------------------
InlineType :: enum(
  Text,
  TextSpecial,
  Softbreak,
  Hardbreak,
  CodeInline,
  HtmlInline,
  EmOpen,
  EmClose,
  StrongOpen,
  StrongClose,
  StrikethroughOpen,
  StrikethroughClose,
  SubscriptOpen,
  SubscriptClose,
  SuperscriptOpen,
  SuperscriptClose,
  MarkOpen,
  MarkClose,
  MathInline,
  MathBlock,
  Emoji,
  Wikilink,
  CriticMarkup,
  FootnoteRef,
  FootnoteInline,
  LinkOpen,
  LinkClose,
  ImageOpen,
  ImageClose,
  Entity
);
derive(InlineType, Copy, Clone);

// ---------------------------------------------------------------------------
// Link reference
// ---------------------------------------------------------------------------
Reference :: struct(
  href : String,
  title : String
);

// ---------------------------------------------------------------------------
// Environment — stores link references discovered during parsing
// ---------------------------------------------------------------------------
Env :: newtype(
  references : HashMap(String, Reference)
);

new_env :: (fn() -> Env)(
  Env(references : HashMap(String, Reference).new())
);

// ---------------------------------------------------------------------------
// StringPair — for HTML attributes
// ---------------------------------------------------------------------------
StringPair :: struct(
  name : String,
  value : String
);

// ---------------------------------------------------------------------------
// Inline token — lightweight, value-type, no RC overhead
// ---------------------------------------------------------------------------
// Delimiter for emphasis/strikethrough resolution
Delimiter :: struct(
  // Character code: '*', '_', '~'
  marker : u8,
  // Number of consecutive markers
  length : i32,
  // Index into inline tokens array
  token_idx : i32,
  // Resolved end (set by balance_pairs)
  end : i32,
  // Skip count for same-run delimiters (prevents self-matching)
  jump : i32,
  // Can open emphasis
  open : bool,
  close : bool // Can close emphasis
);
derive(Delimiter, Copy, Clone);

// Link/image bracket marker — tracks pending [ and ![ positions
LinkMarker :: struct(
  // position of [ in source
  pos : i32,
  // index of the [ text token in tokens array
  token_idx : i32,
  // true for ![
  is_image : bool,
  // can still be used as link opener
  active : bool,
  delimiters_count : i32 // delimiter stack depth when [ was pushed
);
derive(LinkMarker, Copy, Clone);

// A resolved emphasis/strong/strikethrough pair for rendering
EmphasisPair :: struct(
  // token index of opener text
  opener_tok : i32,
  // token index of closer text
  closer_tok : i32,
  // chars consumed from each side (1=em, 2=strong)
  consume : i32,
  pair_type : i32 // 1=em, 2=strong, 3=strikethrough
);
derive(EmphasisPair, Copy, Clone);

export(
  Options,
  default_options,
  commonmark_options,
  ParentType,
  TableAlign,
  InlineType,
  Reference,
  Env,
  new_env,
  StringPair,
  Delimiter,
  LinkMarker,
  EmphasisPair,
  AbbrEntry,
  FootnoteDef
);
